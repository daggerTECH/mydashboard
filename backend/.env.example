# Copy to .env and fill in real values. Never commit .env to version control.

# ---- Server -------------------------------------------------
PORT=4000
NODE_ENV=production

# The exact origin of your deployed Vercel frontend (no trailing slash).
# Used for CORS — only this origin may call the API with credentials.
FRONTEND_URL=https://your-dashboard.vercel.app

# ---- WooCommerce -------------------------------------------------
WC_STORE_URL=https://xlpeptides.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_API_VERSION=wc/v3
WC_VERIFY_SSL=true
WC_TIMEOUT_MS=20000

# ---- Dashboard login -------------------------------------------------
# Generate a bcrypt hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=$2a$10$REPLACE_WITH_A_REAL_BCRYPT_HASH________________________

# Random long string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# ---- Google Analytics 4 (optional) -------------------------------------------------
# Enables a real Conversion Rate on the Sales Overview page: WooCommerce
# orders ÷ GA4 sessions for the same period. Leave GA4_ENABLED=false (the
# default) to keep showing "Requires Google Analytics 4 integration" instead
# of a number — see backend/README.md section 6 for the full setup walkthrough.
GA4_ENABLED=false
GA4_PROPERTY_ID=123456789

# Path to a GA4 service-account JSON key file. This is Google's own standard
# env var name (read directly by Google's client library), not custom to
# this project. Never commit the actual key file — keep it out of git.
GOOGLE_APPLICATION_CREDENTIALS=./ga4-service-account.json

# ---- Google Ads (optional) -------------------------------------------------
# Powers the Marketing & Ads tab's ad-spend side (cost, clicks, impressions,
# conversions per campaign, and ACOS/ROAS/TACOS). Leave GOOGLE_ADS_ENABLED=
# false (the default) and that tab still shows Sales by Channel and
# Attribution Detail from WooCommerce alone — see backend/README.md section 7
# for the full setup walkthrough (it's a longer process than GA4: Google Ads
# API access needs its own developer token and OAuth consent, not just a
# service-account key file).
GOOGLE_ADS_ENABLED=false
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Only needed if you access this account through a Google Ads manager (MCC)
# account rather than directly:
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---- Caching & rate limiting -------------------------------------------------
CACHE_TTL_SECONDS=300
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

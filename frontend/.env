# Copy to .env.local for local dev, and set the same keys as Vercel
# Project → Settings → Environment Variables for deployment.

# Base URL of your Express backend on Oracle Cloud (no trailing slash).
# Leave as-is for local dev against `npm run dev` in ../backend.
VITE_API_BASE_URL=http://localhost:4000

# Set to "false" once the backend is deployed and connected to a real store.
# While "true", the dashboard uses generated sample data (clearly labeled)
# so you can preview every page without a backend at all.
VITE_DEMO_MODE=false
